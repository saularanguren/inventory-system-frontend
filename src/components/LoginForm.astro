---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Bienvenido de nuevo",
  subtitle = "Inicia sesión para continuar"
} = Astro.props;
---

<div class="relative min-h-screen flex items-center justify-center bg-base p-4 overflow-hidden">
  <!-- Ambient glow -->
  <div class="pointer-events-none absolute -top-40 -left-40 h-96 w-96 rounded-full bg-palette-1/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-40 h-96 w-96 rounded-full bg-palette-2/30 blur-3xl"></div>

  <div class="relative w-full max-w-md">
    <!-- Brand -->
    <div class="text-center mb-8">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-palette-1 border border-palette-3/60 mb-4">
        <!-- text-base ya existe como tamaño de fuente; el hint (color:) fuerza el color -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="h-7 w-7 text-(color:--base)"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75M6.75 10.5h10.5a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-7.5a1.5 1.5 0 0 1 1.5-1.5Z"
          />
        </svg>
      </div>
      <h1 class="text-2xl font-semibold text-palette-3 tracking-tight">
        {title}
      </h1>
      <p class="text-sm text-palette-2 mt-1">{subtitle}</p>
    </div>

    <!-- Card -->
    <div class="rounded-2xl border border-palette-3/20 bg-white p-8 shadow-2xl shadow-palette-1/30">
      <form id="login-form" novalidate class="space-y-5">
        <!-- Email -->
        <div class="space-y-1.5">
          <label for="email" class="text-sm font-medium text-palette-3">
            Email
          </label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-palette-3/40 pointer-events-none">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-4 w-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                />
              </svg>
            </span>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@gmail.com"
              required
              aria-describedby="email-error"
              class="w-full h-11 pl-10 pr-3 rounded-lg bg-white border border-palette-3/30 text-palette-3 placeholder:text-palette-3/40 text-sm outline-none transition-all focus:border-palette-1 focus:ring-2 focus:ring-palette-1/40"
            />
          </div>
          <p
            id="email-error"
            role="alert"
            class="text-xs text-[#b84a5a] min-h-[1rem]"
          ></p>
        </div>

        <!-- Password -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="password" class="text-sm font-medium text-palette-3">
              Contraseña
            </label>
            <a
              href="#"
              class="text-xs text-palette-2 hover:text-palette-3 transition-colors"
            >
              ¿Olvidaste tu contraseña?
            </a>
          </div>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-palette-3/40 pointer-events-none">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-4 w-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75M6.75 10.5h10.5a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5H6.75a1.5 1.5 0 0 1-1.5-1.5v-7.5a1.5 1.5 0 0 1 1.5-1.5Z"
                />
              </svg>
            </span>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="••••••••"
              maxlength="20"
              required
              aria-describedby="password-error"
              class="w-full h-11 pl-10 pr-11 rounded-lg bg-white border border-palette-3/30 text-palette-3 placeholder:text-palette-3/40 text-sm outline-none transition-all focus:border-palette-1 focus:ring-2 focus:ring-palette-1/40"
            />
            <button
              type="button"
              id="toggle-password"
              aria-label="Mostrar contraseña"
              class="absolute right-1.5 top-1/2 -translate-y-1/2 p-2 rounded-md text-palette-3/50 hover:text-palette-3 hover:bg-palette-3/10 transition-colors"
            >
              <!-- Eye -->
              <svg
                id="icon-eye"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-4 w-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
              </svg>
              <!-- Eye off -->
              <svg
                id="icon-eye-off"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-4 w-4 hidden"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"
                />
              </svg>
            </button>
          </div>
          <div class="flex items-center justify-between gap-2">
            <p
              id="password-error"
              role="alert"
              class="text-xs text-[#b84a5a] min-h-[1rem]"
            ></p>
            <span
              id="password-counter"
              class="text-xs text-palette-3/50 tabular-nums shrink-0"
            >
              0/20
            </span>
          </div>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full h-11 rounded-lg bg-gradient-to-r from-palette-1 to-palette-2 text-palette-4 font-medium text-sm border border-palette-3 hover:from-palette-2 hover:to-palette-3 active:scale-[0.99] transition-all shadow-lg shadow-palette-1/40 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Iniciar sesión
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  document.title = "Inicia sesión";

  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const emailError = document.getElementById("email-error")!;
  const passwordError = document.getElementById("password-error")!;
  const toggleBtn = document.getElementById("toggle-password")!;
  const iconEye = document.getElementById("icon-eye")!;
  const iconEyeOff = document.getElementById("icon-eye-off")!;
  const counter = document.getElementById("password-counter")!;

  const EMAIL_RE =
    /^(?=.{6,30}@)[a-zA-Z0-9]+(?:\.[a-zA-Z0-9]+)*@(?:gmail|googlemail)\.com$/i;
  const MIN_PASSWORD = 8;
  const MAX_PASSWORD = 20;

  // Clases de estado con la paleta registrada en @theme
  const VALID_BORDER = "border-palette-3/30";
  const VALID_FOCUS = "focus:border-palette-1";
  const VALID_RING = "focus:ring-palette-1/40";
  const ERROR_BORDER = "border-[#b84a5a]/70";
  const ERROR_FOCUS = "focus:border-[#b84a5a]";
  const ERROR_RING = "focus:ring-[#b84a5a]/25";

  function setFieldState(
    input: HTMLInputElement,
    el: HTMLElement,
    msg: string,
  ) {
    el.textContent = msg;
    if (msg) {
      input.classList.remove(VALID_BORDER, VALID_FOCUS, VALID_RING);
      input.classList.add(ERROR_BORDER, ERROR_FOCUS, ERROR_RING);
      input.setAttribute("aria-invalid", "true");
    } else {
      input.classList.remove(ERROR_BORDER, ERROR_FOCUS, ERROR_RING);
      input.classList.add(VALID_BORDER, VALID_FOCUS, VALID_RING);
      input.setAttribute("aria-invalid", "false");
    }
  }

  function validateEmail(): boolean {
    const v = emailInput.value.trim();
    let msg = "";
    if (!v) msg = "El email es obligatorio";
    else if (!EMAIL_RE.test(v)) msg = "Introduce un correo de Gmail válido";
    setFieldState(emailInput, emailError, msg);
    return !msg;
  }

  function validatePassword(): boolean {
    const v = passwordInput.value;
    let msg = "";
    if (!v) msg = "La contraseña es obligatoria";
    else if (v.length < MIN_PASSWORD) msg = `Mínimo ${MIN_PASSWORD} caracteres`;
    else if (v.length > MAX_PASSWORD) msg = `Máximo ${MAX_PASSWORD} caracteres`;
    setFieldState(passwordInput, passwordError, msg);
    counter.textContent = `${v.length}/${MAX_PASSWORD}`;
    return !msg;
  }

  emailInput.addEventListener("blur", validateEmail);
  emailInput.addEventListener("input", () => {
    if (emailError.textContent) validateEmail();
  });

  passwordInput.addEventListener("input", () => {
    counter.textContent = `${passwordInput.value.length}/${MAX_PASSWORD}`;
    if (passwordError.textContent) validatePassword();
  });
  passwordInput.addEventListener("blur", validatePassword);

  toggleBtn.addEventListener("click", () => {
    const isPassword = passwordInput.type === "password";
    passwordInput.type = isPassword ? "text" : "password";
    iconEye.classList.toggle("hidden", isPassword);
    iconEyeOff.classList.toggle("hidden", !isPassword);
    toggleBtn.setAttribute(
      "aria-label",
      isPassword ? "Ocultar contraseña" : "Mostrar contraseña",
    );
    const len = passwordInput.value.length;
    passwordInput.focus();
    passwordInput.setSelectionRange(len, len);
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const okEmail = validateEmail();
    const okPass = validatePassword();
    if (!okEmail || !okPass) {
      (!okEmail ? emailInput : passwordInput).focus();
      return;
    }
    const btn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const original = btn.textContent;
    btn.textContent = "Entrando...";
    btn.disabled = true;

    // 👉 Aquí va tu llamada al backend:
    // await fetch("/api/login", { method: "POST", body: JSON.stringify({...}) })

    setTimeout(() => {
      btn.textContent = original;
      btn.disabled = false;
      console.log("Login OK", { email: emailInput.value.trim() });
    }, 800);
  });
</script>